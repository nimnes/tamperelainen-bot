# Telegram
TELEGRAM_BOT_TOKEN=put_your_bot_token_here
TELEGRAM_CHAT_ID=put_chat_id_here

# Optional: how often to poll RSS when running continuously
POLL_INTERVAL_SECONDS=600

# Number of RSS items to inspect each poll
RSS_LIMIT=20

# Set to true to publish full translated article text.
# false = publish translated title + summary only.
PUBLISH_FULL_ARTICLE=false

# Maximum translated article characters when full article mode is enabled.
MAX_ARTICLE_CHARS=12000
